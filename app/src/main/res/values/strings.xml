    <!-- Silent Wakeup Section -->
    <string name="section_silent_wakeup">Silent Background Wakeup</string>
    <string name="desc_silent_wakeup">If the plugin is not running, wake it up silently before executing tasks with zero screen pop-ups:</string>
    <string name="wakeup_tier1_title">Method 1: Tasker Native Launch (No Root / No Shizuku)</string>
    <string name="wakeup_tier1_desc">In Tasker, add [Send Intent] action:\n• Target: Activity\n• Action: Leave empty\n• Package: com.paddle.ocr.demo\n• Class: com.paddle.ocr.demo.plugin.WakeUpActivity\n(Or launch app activity and select WakeUpActivity)</string>
    <string name="wakeup_tier1_code">com.paddle.ocr.demo/.plugin.WakeUpActivity</string>
    <string name="wakeup_tier2_title">Method 2: Shell / Shizuku Command Line</string>
    <string name="wakeup_tier2_desc">In your macro, add a \"Run Shell\" action (with Root or Shizuku enabled) to execute:</string>
    <string name="wakeup_tier2_code">am start -n com.paddle.ocr.demo/.plugin.WakeUpActivity</string>
