    <!-- Silent Wakeup Section -->
    <string name="section_silent_wakeup">后台静默唤醒</string>
    <string name="desc_silent_wakeup">若插件未在后台运行，可在执行任务前通过以下方式进行无感唤醒，屏幕零弹窗：</string>
    <string name="wakeup_tier1_title">方式一：Tasker 原生免 Root 唤醒</string>
    <string name="wakeup_tier1_desc">在 Tasker 中添加【发送 Intent】动作：\n• 目标 (Target): Activity\n• 操作 (Action): 留空即可\n• 包名 (Package): com.paddle.ocr.demo\n• 类名 (Class): com.paddle.ocr.demo.plugin.WakeUpActivity\n（也可通过启动应用程序活动的动作，选择 WakeUpActivity）</string>
    <string name="wakeup_tier1_code">com.paddle.ocr.demo/.plugin.WakeUpActivity</string>
    <string name="wakeup_tier2_title">方式二：Shell / Shizuku 命令行唤醒</string>
    <string name="wakeup_tier2_desc">在宏脚本中添加“运行 Shell”动作（勾选使用 Root 或 Shizuku），执行以下命令：</string>
    <string name="wakeup_tier2_code">am start -n com.paddle.ocr.demo/.plugin.WakeUpActivity</string>
