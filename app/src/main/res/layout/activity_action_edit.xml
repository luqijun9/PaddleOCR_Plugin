<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="识别模式"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerCaptureMode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editFilePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入或粘贴文件绝对路径"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="目标文本 (可选)"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTargetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入你想查找的文字" />

    <CheckBox
        android:id="@+id/checkIsRegex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用正则表达式匹配" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="此插件将自动截取当前屏幕，并识别文字。如果找到了目标文本，会返回中心坐标。可以通过 Tasker 变量 %ocr_full_text, %match_found, %match_center_x, %match_center_y 获取结果。"
        android:textSize="14sp"
        android:textColor="#666666" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textIsSelectable="true"
        android:text="💡 免弹窗截图：\n如果您有 Root 或 Shizuku，可通过执行以下 ADB 命令隐式授予录屏权限，从此使用“录屏权限”模式不再有确认弹窗：\nappops set com.paddle.ocr.demo PROJECT_MEDIA allow"
        android:textSize="13sp"
        android:textColor="#666666" />
</LinearLayout>
